{
  "workspaces": [
    "apps/*",
    "libs/*",
    "deploy/*"
  ],
  "type": "module",
  "scripts": {
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt --no-error-on-unmatched-pattern apps libs deploy/edge",
    "fmt:check": "oxfmt --check --no-error-on-unmatched-pattern apps libs deploy/edge",
    "web:dev": "bun --filter web dev",
    "web:build": "bun --filter web build",
    "web:check": "bun --filter web check",
    "gen:client": "bun run scripts/gen-client.ts",
    "edge:test": "bun --filter edge test"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "typescript": "npm:typescript-native-bridge@6.0.3-bridge.18.tsgo.7.0.2"
  },
  "overrides": {
    "typescript": "$typescript"
  }
}
