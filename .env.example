# Run `mise install && mise run dev` first.
# `mise run env-init` creates this file with generated secrets. `mise run dev`
# also runs it when `.env` is missing. The command refuses to overwrite `.env`.

COMPUTE_API_TOKEN=

BETTER_AUTH_SECRET=

ORIGIN=http://localhost:3000

# Leave empty unless a browser calls the API directly.
TSDHN_ALLOWED_ORIGINS=

APP_DB_PASSWORD=

# Passwords for the least-privilege queue roles the API, worker, and retention
# use to connect.
COMPUTE_PRODUCER_PASSWORD=
COMPUTE_WORKER_PASSWORD=
COMPUTE_PURGER_PASSWORD=

# Browser-reachable S3 endpoint for output download URLs.
TSDHN_S3_PUBLIC_ENDPOINT=localhost:9000
TSDHN_S3_ACCESS_KEY=tsdhn-local
TSDHN_S3_SECRET_KEY=tsdhn-local-secret
TSDHN_S3_BUCKET=tsdhn-results

# Task queue. The queue name and the schema rqueue owns; both reach the
# migration step and every process that reads or writes the queue, so a value
# set here applies everywhere or nowhere.
COMPUTE_QUEUE=simulations
COMPUTE_QUEUE_SCHEMA=task_queue
