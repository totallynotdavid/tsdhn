# Local development: run `mise install && mise run dev`. `mise run init:env`
# creates `.env` from this file with generated secrets, and `mise run dev`
# runs it when `.env` is missing.
# Production: `scripts/env-init.sh /etc/tsdhn/prod.env`, then fill in the
# production section at the end. See docs/deploy.md.
# The script refuses to overwrite an existing file.

COMPUTE_API_TOKEN=

BETTER_AUTH_SECRET=

ORIGIN=http://localhost:3000

# Leave empty unless a browser calls the API directly.
TSDHN_ALLOWED_ORIGINS=

APP_DB_PASSWORD=

# Passwords for the least-privilege queue roles the API, worker, and retention
# use to connect.
COMPUTE_PRODUCER_PASSWORD=
COMPUTE_WORKER_PASSWORD=
COMPUTE_PURGER_PASSWORD=

# Object storage credentials and bucket. Production uses bundled RustFS unless
# these values name an external store. For Cloudflare R2, use the token keys
# below and add deploy/compose.external-storage.yml to the compose command.
TSDHN_S3_ACCESS_KEY=
TSDHN_S3_SECRET_KEY=
TSDHN_S3_BUCKET=tsdhn-results
# TSDHN_S3_ENDPOINT=<account id>.r2.cloudflarestorage.com
# TSDHN_S3_SECURE=true
# TSDHN_S3_REGION=auto

# Task queue. The queue name and the schema rqueue owns; both reach the
# migration step and every process that reads or writes the queue, so a value
# set here applies everywhere or nowhere.
COMPUTE_QUEUE=simulations
COMPUTE_QUEUE_SCHEMA=task_queue

# Production only (deploy/compose.prod.yml).
# Address where worker hosts reach PostgreSQL. Empty publishes nothing.
# Used with deploy/compose.private.yml.
TSDHN_PRIVATE_ADDR=
TSDHN_PRIVATE_CIDR=100.64.0.0/10
# Password of the PostgreSQL owner role. Local development uses a fixed one.
POSTGRES_PASSWORD=
# Full image references: a release tag or a digest.
API_IMAGE=
WEB_IMAGE=
# Token of the Cloudflare tunnel. Set ORIGIN above to its public URL.
TUNNEL_TOKEN=
# Loopback port the web service publishes for checks from the host.
TSDHN_WEB_PORT=3000
# Days a completed job keeps its output files. 0 keeps them forever.
TSDHN_OUTPUT_RETENTION_DAYS=90
# Backups. The image is the release's tsdhn-backup, named like API_IMAGE.
# BACKUP_PASSWORD encrypts every backup. Copy it somewhere off this host:
# without it the backups cannot be read.
BACKUP_IMAGE=
# restic repository on an S3-compatible bucket, such as
# s3:https://s3.example.org/tsdhn-backups
BACKUP_REPOSITORY=
BACKUP_PASSWORD=
# Credentials of that bucket, not of the storage service above.
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
# Seconds between backups.
BACKUP_INTERVAL_SECONDS=86400
