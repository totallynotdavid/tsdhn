{
  "name": "web",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "serve:preview": "bun --no-env-file scripts/preview.ts",
    "prepare": "svelte-kit sync || echo ''",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "typecheck:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run --exclude 'src/**/*.integration.test.ts' --coverage",
    "test:integration": "vitest run src/lib/server/simulations.integration.test.ts",
    "test:watch": "vitest --exclude 'src/**/*.integration.test.ts'",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "auth:schema": "auth generate --config src/lib/server/auth.ts --output src/lib/server/db/auth.schema.ts --yes"
  },
  "dependencies": {
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@tsdhn/api-client": "workspace:*",
    "bits-ui": "^2.21.0",
    "maplibre-gl": "^6.18.0",
    "sveltekit-superforms": "^3.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@better-auth/drizzle-adapter": "~1.7.22",
    "@electric-sql/pglite": "^0.5.16",
    "@sveltejs/adapter-auto": "^8.0.1",
    "@sveltejs/adapter-node": "^6.0.2",
    "@sveltejs/kit": "^3.2.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "auth": "~1.7.22",
    "better-auth": "~1.7.22",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "mdsvex": "^0.12.8",
    "postgres": "^4.1.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.5",
    "typescript": "npm:typescript-native-bridge@6.0.3-bridge.19.tsgo.7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
