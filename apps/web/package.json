{
  "name": "web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run --exclude 'src/**/*.integration.test.ts'",
    "test:integration": "vitest run src/lib/server/simulations.integration.test.ts",
    "test:watch": "vitest --exclude 'src/**/*.integration.test.ts'",
    "test:coverage": "vitest run --exclude 'src/**/*.integration.test.ts' --coverage",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "auth:schema": "auth generate --config src/lib/server/auth.ts --output src/lib/server/db/auth.schema.ts --yes"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tsdhn/api-client": "workspace:*",
    "bits-ui": "^2.19.5",
    "maplibre-gl": "^6.13.0",
    "sveltekit-superforms": "^3.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@better-auth/drizzle-adapter": "~1.7.7",
    "@sveltejs/adapter-auto": "^8.0.0",
    "@sveltejs/adapter-node": "^6.0.0",
    "@sveltejs/kit": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.3",
    "auth": "~1.7.7",
    "better-auth": "~1.7.7",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "mdsvex": "^0.12.8",
    "postgres": "^3.4.9",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
